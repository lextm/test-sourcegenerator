<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="test_sourcegenerator.MainWindow"
        Title="AXSG ResourceDictionary repro">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Before fix — AvaloniaXamlLoader.Load(uri):" FontWeight="Bold" />
    <TextBlock x:Name="UriLoadText" TextWrapping="Wrap" />
    <TextBlock Text="After fix — new TestDictionary():" FontWeight="Bold" />
    <TextBlock x:Name="DirectLoadText" TextWrapping="Wrap" />
  </StackPanel>
</Window>
